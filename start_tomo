#!/bin/bash
# Open the 19-BM tomography main screen.
#
# The 19-BM counterpart of 2-BM's start_tomo_scan.  Written in bash rather than
# csh, and trimmed to what the simplified mct_main.adl here actually uses: no
# mctoptics or energy screens, no second detector, and ADEuresys in place of
# ADSpinnaker.

# ---------------------------------------------------------------------------
# Optional argument: which camera a scan should use.
#
#   start_tomo            open the screen on whatever tomoscan is set to
#   start_tomo orca       switch tomoscan to the ORCA, then open
#   start_tomo vieworks   switch tomoscan to the Vieworks, then open
#
# The argument changes the REAL selection, not just this screen.  A flag that
# only set the MEDM macro would let the panel show one camera while the scan
# drove the other -- and nothing on screen would contradict it.  So switching
# writes CameraPVPrefix and FilePluginPVPrefix and restarts the python server,
# because the server reads those prefixes once, in __init__.
# ---------------------------------------------------------------------------
CAGET=$(command -v caget || echo /APSshare/epics/base-7.0.8/bin/rhel9-x86_64/caget)
CAPUT=$(command -v caput || echo /APSshare/epics/base-7.0.8/bin/rhel9-x86_64/caput)
TS=19bm:TomoScan:

want_prefix=""
case "${1:-}" in
    "")                      ;;
    orca|ORCA)               want_prefix="ORCA:" ;;
    vieworks|Vieworks|vw)    want_prefix="19bmVieworks:" ;;
    -h|--help)
        cat <<'USAGE'
Usage: start_tomo [orca|vieworks]

  (no argument)  open the screen on whatever camera tomoscan is set to
  orca           switch tomoscan to the ORCA, then open
  vieworks       switch tomoscan to the Vieworks VP-61MX, then open

An argument changes the real selection: it writes CameraPVPrefix and
FilePluginPVPrefix and restarts the tomoscan python server, which reads
those prefixes only at startup.  It refuses while a scan is running, and
refuses if the target camera's IOC is not answering.
USAGE
        exit 0 ;;
    *)  echo "start_tomo: unknown camera '$1' (use orca or vieworks)" >&2
        exit 2 ;;
esac

if [ -n "$want_prefix" ]; then
    current=$("$CAGET" -t "${TS}CameraPVPrefix" 2>/dev/null | tr -d '[:space:]')
    if [ "$current" = "$want_prefix" ]; then
        echo "start_tomo: tomoscan already uses $want_prefix - no restart needed"
    else
        # Refuse while a scan is in progress; swapping the camera mid-scan
        # would abandon the run with its files half written.
        status=$("$CAGET" -t "${TS}ScanStatus" 2>/dev/null)
        case "$status" in
            *"Scan complete"*|*"Aborted"*|"") ;;
            *)  echo "start_tomo: ScanStatus is '$status' - refusing to switch" >&2
                echo "            cameras while a scan is running." >&2
                exit 1 ;;
        esac
        # The target camera's IOC must be up, or tomoscan points at nothing.
        if ! timeout 5 "$CAGET" -t "${want_prefix}cam1:Acquire" >/dev/null 2>&1; then
            echo "start_tomo: ${want_prefix}cam1: is not answering - start that" >&2
            echo "            camera's IOC first." >&2
            exit 1
        fi
        echo "start_tomo: switching tomoscan from ${current:-<unset>} to $want_prefix"
        printf '            this restarts the python server. Continue? [y/N] '
        read -r reply
        case "$reply" in
            y|Y|yes|YES) ;;
            *) echo "            aborted."; exit 1 ;;
        esac
        "$CAPUT" "${TS}CameraPVPrefix"     "$want_prefix"        >/dev/null
        "$CAPUT" "${TS}FilePluginPVPrefix" "${want_prefix}HDF1:" >/dev/null
        bash /home/beams/FACTUSER/bin/tomoscan_server_stop.sh >/dev/null 2>&1
        sleep 3
        bash /home/beams/FACTUSER/bin/tomoscan_server.sh      >/dev/null 2>&1 &
        printf '            waiting for the server'
        for _ in $(seq 1 20); do
            sleep 2; printf '.'
            [ "$("$CAGET" -t "${TS}ServerRunning" 2>/dev/null)" = "Running" ] && break
        done
        echo
        if [ "$("$CAGET" -t "${TS}ServerRunning" 2>/dev/null)" != "Running" ]; then
            echo "start_tomo: server did not come back - check its terminal." >&2
        fi
    fi
fi

ADL=/home/beams/FACTUSER/bin/adl
TOMOSCAN=/home/beams/FACTUSER/epics/synApps/support/tomoscan
AREA_DETECTOR=/APSshare/epics/synApps_6_3/support/areaDetector-R3-14
MOTOR=/APSshare/epics/synApps_6_3/support/motor-R7-3-1

# mct_main.adl opens related displays from several modules, so unlike the
# tomoscan screens these cannot be found relative to the parent file.
export EPICS_DISPLAY_PATH="$ADL\
:$TOMOSCAN/tomoScanApp/op/adl\
:$AREA_DETECTOR/ADEuresys/EuresysApp/op/adl\
:$AREA_DETECTOR/ADGenICam/GenICamApp/op/adl\
:$AREA_DETECTOR/ADCore/ADApp/op/adl\
:$MOTOR/motorApp/op/adl"
# No entry for another beamline's account here, deliberately.  detector_status.adl
# and DTaggingUpdate.adl used to be read out of /home/beams/2BMB/bin/adl; local
# copies now live in $ADL.  Both originate from mctoptics
# (mctOpticsApp/op/adl/), which 19-BM does not install, so a local copy is the
# right home for them rather than a path into a package we do not have.

# --- tomoscan IOC -----------------------------------------------------------
TS=19bm:
TS_R=TomoScan:
TS_BEAMLINE=tomoScan_19BM

# --- optics metadata --------------------------------------------------------
# At 2-BM this pair is the mctOptics prefix (P=2bm:, R=MCTOptics:).  19-BM has
# no optics server: six of those nine records -- ScintillatorType,
# ScintillatorThickness, ImagePixelSize, DetectorPixelSize, CameraObjective and
# CameraTubeLength -- are plain records in the tomoscan IOC instead, so P/R
# point there.  Camera0Bit, SuggestedAngles and SuggestedAngleStep are
# mctOptics-only and stay disconnected.
P=19bm:
R=TomoScan:

# --- tomoscan stream --------------------------------------------------------
# 19-BM runs no stream IOC; these resolve but the widgets stay disconnected.
TSS=19bm:
TSS_R=TomoScanStream:

# --- detector ---------------------------------------------------------------
# Which camera a scan actually uses is a runtime PV in the tomoscan IOC, not a
# property of this screen: the python server reads CameraPVPrefix in __init__
# and drives whatever it names.  Read it here so the Camera panel always shows
# the camera tomoscan will really use -- otherwise the panel and the scan can
# disagree silently, which looks exactly like working correctly.
#
# Changing cameras therefore means caput'ing CameraPVPrefix and
# FilePluginPVPrefix and RESTARTING THE PYTHON SERVER, then reopening this
# screen.  The Detector button offers both cameras regardless of the selection.
#
# Note the ORCA serves no Proc1 plugin, so the flat-field widgets that use
# $(AD0_PROC1) stay blank when it is selected.  That is expected, not a fault.
CAGET=$(command -v caget || echo /APSshare/epics/base-7.0.8/bin/rhel9-x86_64/caget)
AD0=$("$CAGET" -t 19bm:TomoScan:CameraPVPrefix 2>/dev/null | tr -d '[:space:]')
case "$AD0" in
    ORCA:)         AD0_MODEL=ORCA_C16240 ;;
    19bmVieworks:) AD0_MODEL=ViewWorks_VP61MX ;;
    *)  echo "start_tomo: cannot read 19bm:TomoScan:CameraPVPrefix" \
             "(tomoScan IOC down?) - defaulting to the Vieworks" >&2
        AD0=19bmVieworks:
        AD0_MODEL=ViewWorks_VP61MX ;;
esac
echo "start_tomo: camera panel bound to $AD0"
AD0_CAM=cam1:
AD0_PROC1=Proc1:
AD0_HDF=HDF1:

# --- motors -----------------------------------------------------------------
# The screen drives seven axes through three prefixes.  At 2-BM they are:
#
#   $(P1)$(M3)   2bmb:m102     rotary stage
#   $(P2)$(M5)   2bmb:m18      Z on top of the rotary
#   $(P2)$(M6)   2bmb:m17      X on top of the rotary, called "0/180"
#   $(P3)$(M1)   2bmHXP:m3     \
#   $(P3)$(M2)   2bmHXP:m1      | the hexapod, under the rotary
#   $(P3)$(M9)   2bmHXP:m4      |
#   $(P3)$(M18)  2bmHXP:m5     /
#
# P1 is set: 19bmSoft:aero:m1 is the 19-BM rotary stage and works today.
#
# P3 is the hexapod, which has been moved from 7-BM, with the prefix 19bmHXP: with axes
# m1 X, m2 Y, m3 Z, m4 A, m5 B, m6 C.
#
# P2 is the X and Z pair that sits on top of the rotary, prefix 19bmSoft:.
#
P1=19bmSoft:
M3=aero:m1

# --- white-beam slits, 19-BM-A --------------------------------------------
# The four blades are driven individually; M20-M23 are the screen's
# X-/X+/Y-/Y+ slots.  "Inboard" and "outboard" follow the APS X convention:
# positive X is outboard, away from the ring centre.  The live readbacks agree
# with that reading -- the blades sit symmetric about zero at outboard +9.999,
# inboard -9.999, top +2.500, bottom -2.500.
#
#   M20  X-  19bmSoft:m3  WB Slit Inboard
#   M21  X+  19bmSoft:m1  WB Slit Outboard
#   M22  Y-  19bmSoft:m4  WB Slit Bottom
#   M23  Y+  19bmSoft:m2  WB Slit Top
#
# These are white-beam apertures.  The same four motors are also driven by the
# Slit1H/Slit1V composite records in 19bmSoft (Slit1Hsize, Slit1Hcenter,
# Slit1Vsize, Slit1Vcenter), so a blade moved here changes those too.
M20=m3
M21=m1
M22=m4
M23=m2

# --- hexapod base lift ------------------------------------------------------
# M30 drives 19bmSoft:m23, "hex base Y" in the beamline motor list: the lift
# the hexapod sits on, not one of the hexapod's own six axes (those are P3,
# 19bmHXP:).  Same IOC as the slits, hence P1.
#
# Numbering starts at M30 for this group on purpose.  The macro number has
# never matched the motor number on this screen (M1=m2, M20=m3, M5=m22), and
# m17/m18/m24 are due to be added next -- M18 and M23 are already taken, so a
# macro named after a motor number would eventually point at a different one.
M30=m23

# --- high-magnification optics ----------------------------------------------
# Four more 19bmSoft steppers, from the beamline motor list.  Screen order is
# left to right as they appear in the block.
#
#   M31  19bmSoft:m17  high mag focus
#   M32  19bmSoft:m18  high mag camera rotation
#   M33  19bmSoft:m24  Optics_X
#   M34  19bmSoft:m11  Optics Y
#
# Optics_Z is NOT here: it is 19bmSoft:aero:m2, on the second Aerotech rather
# than the stepper controller, so it does not belong in this group.
M31=m17
M32=m18
M33=m24
M34=m11

# Optics_Z is the odd one in this group: it is on the second Aerotech
# (19bmSoft:aero:m2), not the stepper controller, so the macro carries the
# "aero:" segment the way M3 does for the rotation stage.  Same P1 prefix.
M35=aero:m2

P2=19bmSoft:
M5=m22
M6=m21

P3=19bmHXP:
M1=m2
M2=m1
M9=m4
M18=m5

MACROS="P=$P,R=$R"
MACROS="$MACROS,TS=$TS,TS_R=$TS_R,TS_BEAMLINE=$TS_BEAMLINE,TSS=$TSS,TSS_R=$TSS_R"
MACROS="$MACROS,AD0=$AD0,AD0_CAM=$AD0_CAM,AD0_PROC1=$AD0_PROC1,AD0_HDF=$AD0_HDF,AD0_MODEL=$AD0_MODEL"
MACROS="$MACROS,P1=$P1,P2=$P2,P3=$P3"
MACROS="$MACROS,M1=$M1,M2=$M2,M3=$M3,M5=$M5,M6=$M6,M9=$M9,M18=$M18"
MACROS="$MACROS,M20=$M20,M21=$M21,M22=$M22,M23=$M23"
MACROS="$MACROS,M30=$M30"
MACROS="$MACROS,M31=$M31,M32=$M32,M33=$M33,M34=$M34"
MACROS="$MACROS,M35=$M35"

medm -x -macro "$MACROS" "$ADL/mct_main.adl" &
